{
    "model": "Custom CNN Regularized",
    "image_size": [
        224,
        224
    ],
    "batch_size": 32,
    "epochs_requested": 20,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "binary_crossentropy",
    "convolution_filters": [
        32,
        64,
        128
    ],
    "padding": "same",
    "batch_normalization": true,
    "l2_regularization": 0.001,
    "conv_dropout": 0.25,
    "dense_dropout": [
        0.5,
        0.5
    ],
    "augmentation": true,
    "label_mapping": {
        "Fresh": 0,
        "NonFresh": 1
    },
    "train_images": 1418,
    "validation_images": 223,
    "test_images": 261,
    "test_used_during_training": false,
    "checkpoint_monitor": "val_loss",
    "checkpoint_mode": "min",
    "seed": 42
}