{
    "model": "ResNet50 + MobileNetV2 Feature Fusion",
    "model_type": "dual_backbone_feature_fusion",
    "resnet50": {
        "weights": "ImageNet",
        "include_top": false,
        "pooling": "avg",
        "frozen": true,
        "branch_dense_units": [
            512,
            256
        ],
        "branch_dropout": [
            0.5,
            0.5
        ],
        "preprocessing": "tensorflow.keras.applications.resnet50.preprocess_input"
    },
    "mobilenetv2": {
        "weights": "ImageNet",
        "include_top": false,
        "pooling": "avg",
        "alpha": 1.0,
        "frozen": true,
        "branch_dense_units": [
            256,
            128
        ],
        "branch_dropout": [
            0.5,
            0.5
        ],
        "preprocessing": "tensorflow.keras.applications.mobilenet_v2.preprocess_input"
    },
    "fusion_method": "concatenation",
    "fused_feature_dimension": 384,
    "fusion_dense_units": [
        256,
        128,
        64
    ],
    "fusion_dropout": [
        0.5,
        0.5,
        0.3
    ],
    "batch_normalization": true,
    "image_size": [
        224,
        224
    ],
    "batch_size": 32,
    "epochs_requested": 20,
    "optimizer": "Adam",
    "learning_rate": 0.0001,
    "loss": "binary_crossentropy",
    "metrics": [
        "binary_accuracy",
        "auc"
    ],
    "augmentation": true,
    "label_mapping": {
        "Fresh": 0,
        "NonFresh": 1
    },
    "train_images": 1418,
    "validation_images": 223,
    "test_images": 261,
    "test_used_during_training": false,
    "checkpoint_monitor": "val_loss",
    "checkpoint_mode": "min",
    "seed": 42,
    "methodological_corrections": [
        "Separate ResNet50 and MobileNetV2 preprocessing applied to each branch",
        "No generic 1/255 rescaling before pretrained backbones",
        "Validation dataset used for checkpoint selection",
        "Test set not used during training or model selection",
        "Feature fusion implemented by concatenation"
    ]
}